menu "WiFi Repeater Configuration"

    menu "Upstream AP (STA) Settings"
        config REPEATER_UPSTREAM_SSID
            string "Upstream AP SSID (default)"
            default "MyUpstreamAP"
            help
                Domyślny SSID upstream AP. Nadpisywany przez NVS / web GUI.

        config REPEATER_UPSTREAM_PASSWORD
            string "Upstream AP Password (default)"
            default "password123"
            help
                Domyślne hasło upstream AP. Nadpisywane przez NVS / web GUI.
    endmenu

    menu "Repeater AP Settings"
        config REPEATER_AP_SSID
            string "Repeater AP SSID (default)"
            default "MyRepeater1"
            help
                Domyślny SSID AP repeatera. Nadpisywany przez NVS / web GUI.

        config REPEATER_AP_PASSWORD
            string "Repeater AP Password (default)"
            default "repeater123"
            help
                Domyślne hasło AP. Nadpisywane przez NVS / web GUI.

        config REPEATER_MAX_CLIENTS
            int "Max connected clients"
            range 1 10
            default 4
            help
                Maksymalna liczba klientów podłączonych do AP repeatera.

        choice REPEATER_AP_AUTHMODE
            prompt "AP Authentication Mode (default)"
            default REPEATER_AP_AUTH_WPA2
            help
                Domyślny tryb uwierzytelniania AP repeatera.
                Nadpisywany przez NVS / web GUI.

                UWAGA: WPA2/WPA3 (tryb przejściowy) bywa problematyczny —
                część telefonów próbuje SAE i kończy na
                "unsuccessful auth/assoc". Dlatego domyślnie jest WPA2-PSK,
                który działa ze wszystkim. WPA3 możesz włączyć w GUI, jeśli
                Twoje klienty go poprawnie obsługują.

            config REPEATER_AP_AUTH_WPA
                bool "WPA-PSK"
            config REPEATER_AP_AUTH_WPA2
                bool "WPA2-PSK"
            config REPEATER_AP_AUTH_WPA_WPA2
                bool "WPA/WPA2-PSK"
            config REPEATER_AP_AUTH_WPA2_WPA3
                bool "WPA2/WPA3-PSK"
            config REPEATER_AP_AUTH_WPA3
                bool "WPA3-PSK"
        endchoice

        config REPEATER_AP_AUTHMODE_VAL
            int
            default 2 if REPEATER_AP_AUTH_WPA
            default 3 if REPEATER_AP_AUTH_WPA2
            default 4 if REPEATER_AP_AUTH_WPA_WPA2
            default 7 if REPEATER_AP_AUTH_WPA2_WPA3
            default 6 if REPEATER_AP_AUTH_WPA3

        config REPEATER_AP_CLONE_SSID
            bool "Clone upstream AP SSID for Repeater AP"
            default n
            help
                Gdy włączone, AP repeatera automatycznie przejmuje SSID
                upstream AP (po połączeniu STA). Klienci widzą tę samą
                sieć co upstream — repeater działa przezroczyście.
                Pole "Repeater AP SSID" jest wtedy ignorowane.
    endmenu

    menu "Roaming (Pseudo-Mesh)"
        config REPEATER_PSEUDO_MESH
            bool "Enable pseudo-mesh roaming"
            default n
            help
                Gdy włączone, repeater monitoruje RSSI upstream AP.
                Jeśli sygnał spadnie poniżej progu, skanuje w poszukiwaniu
                innego AP z tym samym SSID ale innym BSSID (pomijając
                własny AP). Przełącza się na AP z najlepszym sygnałem.

        config REPEATER_ROAM_RSSI_THRESHOLD
            int "Roaming RSSI threshold (dBm)"
            depends on REPEATER_PSEUDO_MESH
            range -90 -30
            default -70
            help
                Jeśli RSSI upstream AP spadnie poniżej tej wartości,
                repeater rozpocznie skanowanie w poszukiwaniu lepszego AP.
                Wartość w dBm (np. -70 = dość słaby sygnał).

        config REPEATER_ROAM_HYSTERESIS
            int "Roaming hysteresis (dB)"
            depends on REPEATER_PSEUDO_MESH
            range 3 20
            default 8
            help
                Nowy AP musi mieć RSSI o tyle dB lepszy od obecnego,
                żeby nastąpił roaming. Zapobiega ciągłemu przełączaniu.
    endmenu

    menu "Radio Settings"
        config REPEATER_TX_POWER
            int "TX Power (dBm, default)"
            range 2 20
            default 20
            help
                Domyślna moc nadawania WiFi w dBm. Nadpisywana przez NVS / web GUI.

        # ── Band mode (tylko SoC z 5 GHz, np. ESP32-C5) ──────────────
        choice REPEATER_BAND_MODE
            prompt "WiFi band mode (default)"
            depends on SOC_WIFI_SUPPORT_5G
            default REPEATER_BAND_AUTO
            help
                Pasmo pracy radia. UWAGA: ESP32-C5 ma jedno radio —
                "auto" NIE oznacza jednoczesnej pracy dual-band, tylko
                automatyczny wybór pasma na podstawie upstream AP.
                Nadpisywane przez NVS / web GUI.

            config REPEATER_BAND_AUTO
                bool "2.4 GHz + 5 GHz (auto)"
            config REPEATER_BAND_2G
                bool "2.4 GHz only"
            config REPEATER_BAND_5G
                bool "5 GHz only"
        endchoice

        # wifi_band_mode_t: 1=2G_ONLY, 2=5G_ONLY, 3=AUTO
        config REPEATER_BAND_MODE_VAL
            int
            default 3 if REPEATER_BAND_AUTO
            default 1 if REPEATER_BAND_2G
            default 2 if REPEATER_BAND_5G
            default 1

        config REPEATER_RSSI_5G_ADJUSTMENT
            int "Prefer 5 GHz AP margin (dB)"
            depends on SOC_WIFI_SUPPORT_5G
            range 0 30
            default 10
            help
                Jeśli AP 5 GHz o tym samym SSID ma RSSI nie gorszy niż
                (RSSI 2.4 GHz - ta wartość), wybierany jest AP 5 GHz.
                Wyższa wartość = agresywniejsza preferencja 5 GHz.

        # ── Bandwidth 2.4 GHz ───────────────────────────────────────
        choice REPEATER_BW_2G
            prompt "2.4 GHz bandwidth (default)"
            default REPEATER_BW_2G_20 if SOC_WIFI_HE_SUPPORT
            default REPEATER_BW_2G_40
            help
                UWAGA: 40 MHz i HE/VHT wykluczają się w sterowniku ESP.
                Wybór 40 MHz automatycznie WYŁĄCZA 11ax w tym pasmie
                (firmware zdejmie 11AX z maski protokołów).

                20 MHz + 11ax (HE20) = 143 Mbps PHY @ 1SS
                40 MHz + 11n  (HT40) = 150 Mbps PHY @ 1SS
                Na SoC z WiFi 6 HE20 jest zwykle lepszym wyborem.

            config REPEATER_BW_2G_20
                bool "20 MHz (HE / WiFi 6 aktywne)"
            config REPEATER_BW_2G_40
                bool "40 MHz (WiFi 4 HT40, bez 11ax)"
        endchoice

        # wifi_bandwidth_t: 1=WIFI_BW20, 2=WIFI_BW40
        config REPEATER_BW_2G_VAL
            int
            default 1 if REPEATER_BW_2G_20
            default 2 if REPEATER_BW_2G_40

        # ── Bandwidth 5 GHz ─────────────────────────────────────────
        choice REPEATER_BW_5G
            prompt "5 GHz bandwidth (default)"
            depends on SOC_WIFI_SUPPORT_5G
            default REPEATER_BW_5G_20
            help
                ZOSTAW 20 MHz. Zweryfikowane na ESP32-C5: SoftAP pracujący
                w 5 GHz przy 40 MHz psuje 4-way handshake WPA2 — klient
                kojarzy się, a po ~4 s jest wyrzucany z reason 15
                (4WAY_HANDSHAKE_TIMEOUT), i to za każdym razem. Po zejściu na
                20 MHz ten sam telefon łączy się od pierwszej próby.

                20 MHz w 5 GHz ma tę zaletę, że zachowuje 11ax/11ac, czyli
                pracujesz w HE20.

                40 MHz warto włączać w 2.4 GHz, gdzie działa poprawnie i daje
                zmierzone 41 Mb/s przez bridge (wobec 28 Mb/s przy HE20).

            config REPEATER_BW_5G_20
                bool "20 MHz (HE20, 11ax — zalecane)"
            config REPEATER_BW_5G_40
                bool "40 MHz (psuje kojarzenie klientów — nie używać)"
        endchoice

        config REPEATER_BW_5G_VAL
            int
            default 1 if REPEATER_BW_5G_20
            default 2 if REPEATER_BW_5G_40
            default 1
    endmenu

    menu "HTTP Configuration Server"
        config REPEATER_HTTPD_ENABLE
            bool "Enable HTTP configuration server"
            default y
            help
                Włącza wbudowany serwer HTTP do konfiguracji repeatera
                przez przeglądarkę. Dostępny pod adresem IP repeatera
                gdy STA jest połączone z upstream AP (w trybie IDLE).
                Port 80.

        config REPEATER_HTTPD_PORT
            int "HTTP server port"
            depends on REPEATER_HTTPD_ENABLE
            default 80
            range 1 65535
            help
                Port serwera HTTP konfiguracyjnego.
    endmenu

    menu "Performance"
        config REPEATER_CPU_STATS
            bool "Report CPU load in the status log"
            default n
            select FREERTOS_USE_TRACE_FACILITY
            select FREERTOS_GENERATE_RUN_TIME_STATS
            help
                Dolicza do raportu statusu udział zadania IDLE, czyli ile CPU
                zostaje wolnego. Służy do odpowiedzi na pytanie "czy throughput
                ogranicza CPU, czy czas antenowy":

                  idle blisko 0%  -> ogranicza CPU
                  idle wyraźnie >0% -> ogranicza radio / czas antenowy

                Run-time stats dokładają narzut przy każdym przełączeniu
                kontekstu, więc trzymaj to WYŁĄCZONE przy pomiarach
                przepustowości i włączaj tylko na czas diagnozy.

        config REPEATER_BROADCAST_FILTER
            bool "Filter broadcast/multicast before lwIP"
            default y
            help
                When enabled, only ARP requests targeting the repeater's
                own IPs are passed to the lwIP stack. All other broadcast
                and multicast traffic (mDNS, SSDP, NetBIOS, IGMP, IPv6
                multicast, DHCP for other hosts, etc.) is forwarded at L2
                but skipped by lwIP — saving ~10-20k CPU cycles per packet.

                Measured improvement: ~13 → 15 Mb/s on ESP32-C6 (WiFi 6, HE20).

                Disable if you need the repeater itself to receive mDNS,
                SSDP or other multicast/broadcast protocols (rare use case).
    endmenu

endmenu
